# 复制本文件为 .env，然后把值填上（.env 不要提交到 git）
# 注意：值不要加引号、不要带逗号，等号左边只写一次变量名

# 必填：火山方舟 API Key
ARK_API_KEY=

# 可选：模型与接口地址，一般不用改
ARK_MODEL=doubao-seed-2-1-lite-260915
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 阶段 3：联网搜索（https://tavily.com 免费额度够练习）
TAVILY_API_KEY=

# 阶段 4：向量化模型。用阿里百炼就配 DASHSCOPE_API_KEY，否则回落方舟 embedding
EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 1 = 尽量走 Agent，0 = 强制纯对话
USE_AGENT=1

# 模型请求超时（秒）。联网搜索/长回答容易超过 60s，报 TimeoutError 就调大这个
LLM_TIMEOUT=180

# 阶段 5：多轮记忆（LangGraph SqliteSaver）
# 历史消息超过 MEMORY_TRIGGER 条就交给模型压缩，只保留 MEMORY_KEEP 条原文
MEMORY_TRIGGER=20
MEMORY_KEEP=10
